<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Racines des familles de styles : les noms pointés (Vigie.Text.Body…)
         en héritent implicitement. -->
    <style name="Vigie" />
    <style name="Vigie.Text" />

    <!-- Carte plate, bordée d'un filet : la hiérarchie vient des titres et des
         espacements, pas d'une pile d'ombres portées. -->
    <style name="Vigie.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardBackgroundColor">@color/background_card</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- ==================== Texte ==================== -->

    <!-- Titre d'une carte : "Clamart → Villepreux", "Trains suivis" -->
    <style name="Vigie.Text.CardTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Intitulé de section, en petites capitales espacées -->
    <style name="Vigie.Text.Overline">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Vigie.Text.Body">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Vigie.Text.Body.Strong">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Vigie.Text.Secondary">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Vigie.Text.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_hint</item>
    </style>

    <!-- Heure mise en avant : chiffres à chasse fixe, les colonnes restent alignées -->
    <style name="Vigie.Text.Time">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Pastille de statut ("À l'heure", "+4 min") : fond posé par TrainStyle.pill -->
    <style name="Vigie.Text.Pill">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- Message de liste vide ou de chargement -->
    <style name="Vigie.Text.Empty">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_hint</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <!-- Petite icône cliquable (épingle, plan, fermer) -->
    <style name="Vigie.IconButton">
        <item name="android:layout_width">@dimen/icon_touch</item>
        <item name="android:layout_height">@dimen/icon_touch</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
