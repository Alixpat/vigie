<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_l">

        <!-- ============ ÉTAT DE LA LIGNE ============ -->
        <!-- Un tap sur l'en-tête déplie les perturbations et les travaux,
             rangés dans la même carte. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/lineStatusCard"
            style="@style/Vigie.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/lineStatusHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/space_l"
                    android:paddingEnd="@dimen/space_s"
                    android:paddingTop="@dimen/space_m"
                    android:paddingBottom="@dimen/space_m"
                    android:background="?attr/selectableItemBackground">

                    <!-- Pictogramme de la ligne -->
                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_line_badge"
                        android:gravity="center"
                        android:text="N"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_line_n"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_m"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/lineStatusTitle"
                                style="@style/Vigie.Text.CardTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ligne N" />

                            <TextView
                                android:id="@+id/lineStatusBadge"
                                style="@style/Vigie.Text.Pill"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_s"
                                android:visibility="gone" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/lineStatusSummary"
                            style="@style/Vigie.Text.Secondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Chargement…" />

                        <TextView
                            android:id="@+id/lineStatusUpdate"
                            style="@style/Vigie.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/lineStatusChevron"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="@dimen/space_xs"
                        android:src="@drawable/ic_expand_more"
                        app:tint="@color/text_hint"
                        android:importantForAccessibility="no"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/lineMapButton"
                        style="@style/Vigie.IconButton"
                        android:layout_marginStart="@dimen/space_xs"
                        android:src="@drawable/ic_map"
                        app:tint="@color/text_secondary"
                        android:contentDescription="Voir le plan de la ligne" />
                </LinearLayout>

                <!-- Perturbations (visibles uniquement si dépliées et présentes) -->
                <LinearLayout
                    android:id="@+id/perturbationsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_m"
                    android:paddingEnd="@dimen/space_m"
                    android:paddingBottom="@dimen/space_s"
                    android:visibility="gone">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/trainRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>

                <!-- Infos planifiées / travaux -->
                <LinearLayout
                    android:id="@+id/travauxSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_m"
                    android:paddingEnd="@dimen/space_m"
                    android:paddingBottom="@dimen/space_s"
                    android:visibility="gone">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/travauxRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ TRAINS SUIVIS ============ -->
        <!-- Les trains épinglés, tous sens confondus. Masquée tant qu'aucun
             train n'est suivi. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/pinnedCard"
            style="@style/Vigie.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_m"
            android:visibility="gone"
            app:strokeColor="@color/line_n">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/space_l"
                    android:paddingEnd="@dimen/space_l"
                    android:paddingBottom="@dimen/space_xs">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="@dimen/space_s"
                        android:src="@drawable/ic_pin"
                        app:tint="@color/line_n"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/pinnedTitle"
                        style="@style/Vigie.Text.CardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Trains suivis" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/pinnedRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <TextView
                    android:id="@+id/pinnedEmpty"
                    style="@style/Vigie.Text.Empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Train suivi hors de portée des horaires publiés."
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ SENS ALLER : Clamart → Villepreux ============ -->
        <!-- Une carte par sens : les prochains départs puis les trains en
             circulation. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/directionCardAller"
            style="@style/Vigie.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_m"
                android:paddingBottom="@dimen/space_xs">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/space_l"
                    android:paddingEnd="@dimen/space_l">

                    <TextView
                        android:id="@+id/scheduleTitleAller"
                        style="@style/Vigie.Text.CardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Clamart → Villepreux" />

                    <TextView
                        android:id="@+id/scheduleLastUpdateAller"
                        style="@style/Vigie.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:id="@+id/departuresTitleAller"
                    style="@style/Vigie.Text.Overline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/space_l"
                    android:paddingEnd="@dimen/space_l"
                    android:paddingTop="@dimen/space_l"
                    android:paddingBottom="@dimen/space_xs"
                    android:text="Prochains départs" />

                <TextView
                    android:id="@+id/scheduleEmptyAller"
                    style="@style/Vigie.Text.Empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Chargement des horaires…" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/scheduleRecyclerViewAller"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/ongoingTitleAller"
                    style="@style/Vigie.Text.Overline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/space_l"
                    android:paddingEnd="@dimen/space_l"
                    android:paddingTop="@dimen/space_l"
                    android:paddingBottom="@dimen/space_xs"
                    android:text="En circulation" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/ongoingRecyclerViewAller"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <TextView
                    android:id="@+id/ongoingEmptyAller"
                    style="@style/Vigie.Text.Empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Aucun train entre Clamart et Villepreux."
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ SENS RETOUR : Villepreux → Clamart ============ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/directionCardRetour"
            style="@style/Vigie.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_m"
                android:paddingBottom="@dimen/space_xs">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/space_l"
                    android:paddingEnd="@dimen/space_l">

                    <TextView
                        android:id="@+id/scheduleTitleRetour"
                        style="@style/Vigie.Text.CardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Villepreux → Clamart" />

                    <TextView
                        android:id="@+id/scheduleLastUpdateRetour"
                        style="@style/Vigie.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:id="@+id/departuresTitleRetour"
                    style="@style/Vigie.Text.Overline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/space_l"
                    android:paddingEnd="@dimen/space_l"
                    android:paddingTop="@dimen/space_l"
                    android:paddingBottom="@dimen/space_xs"
                    android:text="Prochains départs" />

                <TextView
                    android:id="@+id/scheduleEmptyRetour"
                    style="@style/Vigie.Text.Empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Chargement des horaires…" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/scheduleRecyclerViewRetour"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/ongoingTitleRetour"
                    style="@style/Vigie.Text.Overline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/space_l"
                    android:paddingEnd="@dimen/space_l"
                    android:paddingTop="@dimen/space_l"
                    android:paddingBottom="@dimen/space_xs"
                    android:text="En circulation" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/ongoingRecyclerViewRetour"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <TextView
                    android:id="@+id/ongoingEmptyRetour"
                    style="@style/Vigie.Text.Empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Aucun train entre Villepreux et Clamart."
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
