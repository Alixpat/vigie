<?xml version="1.0" encoding="utf-8"?>
<!-- Un train en circulation : une ligne de la carte, pas une carte dans la carte. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Filet de séparation, masqué sur la première ligne -->
    <View
        android:id="@+id/ongoingDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/space_l"
        android:background="@color/divider" />

    <LinearLayout
        android:id="@+id/ongoingContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_l"
        android:paddingEnd="@dimen/space_l"
        android:paddingTop="@dimen/space_s"
        android:paddingBottom="@dimen/space_m"
        android:background="?attr/selectableItemBackground">

        <!-- Terminus (ou sens) + statut + épingle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/ongoingDirection"
                style="@style/Vigie.Text.Body.Strong"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/ongoingStatus"
                style="@style/Vigie.Text.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s" />

            <ImageView
                android:id="@+id/ongoingPin"
                style="@style/Vigie.IconButton"
                android:layout_marginEnd="-10dp"
                android:src="@drawable/ic_pin"
                android:contentDescription="Suivre ce train" />
        </LinearLayout>

        <!-- Position à l'instant T -->
        <TextView
            android:id="@+id/ongoingPosition"
            style="@style/Vigie.Text.Body.Strong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/line_n" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/ongoingProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:max="100"
            app:trackThickness="4dp"
            app:trackCornerRadius="2dp"
            app:indicatorColor="@color/line_n"
            app:trackColor="@color/card_stroke" />

        <!-- Prochain arrêt -->
        <TextView
            android:id="@+id/ongoingNextStop"
            style="@style/Vigie.Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:fontFeatureSettings="tnum" />

        <!-- Arrivée à ma gare de destination -->
        <TextView
            android:id="@+id/ongoingEta"
            style="@style/Vigie.Text.Body.Strong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFeatureSettings="tnum" />

        <!-- Départ de ma gare + voie -->
        <TextView
            android:id="@+id/ongoingDeparture"
            style="@style/Vigie.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:fontFeatureSettings="tnum" />

        <!-- Numéro de train / mission -->
        <TextView
            android:id="@+id/ongoingTrainInfo"
            style="@style/Vigie.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />
    </LinearLayout>

</LinearLayout>
