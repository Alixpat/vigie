<?xml version="1.0" encoding="utf-8"?>
<!-- En-tête d'un groupe d'incidents de même sévérité, dépliable. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/space_xs"
    android:paddingEnd="@dimen/space_xs"
    android:paddingTop="@dimen/space_s"
    android:paddingBottom="@dimen/space_s"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackground">

    <View
        android:id="@+id/headerColorDot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/circle_indicator" />

    <TextView
        android:id="@+id/headerLabel"
        style="@style/Vigie.Text.Overline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/space_s" />

    <ImageView
        android:id="@+id/headerChevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_expand_more"
        app:tint="@color/text_hint"
        android:importantForAccessibility="no" />

</LinearLayout>
