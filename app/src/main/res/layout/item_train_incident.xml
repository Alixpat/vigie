<?xml version="1.0" encoding="utf-8"?>
<!-- Un incident : tuile en retrait dans la carte « Ligne N », dépliable. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/incidentCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_xs"
    android:layout_marginBottom="@dimen/space_xs"
    android:orientation="vertical"
    android:background="@drawable/bg_tile">

    <LinearLayout
        android:id="@+id/incidentContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_m"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <!-- Sévérité + cause + chevron -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/incidentSeverity"
                style="@style/Vigie.Text.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/incidentCause"
                style="@style/Vigie.Text.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_s"
                android:gravity="end"
                android:maxLines="1"
                android:ellipsize="end" />

            <ImageView
                android:id="@+id/incidentChevron"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="@dimen/space_xs"
                android:src="@drawable/ic_expand_more"
                app:tint="@color/text_hint"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <!-- Titre (caché si générique ou identique au badge) -->
        <TextView
            android:id="@+id/incidentTitle"
            style="@style/Vigie.Text.Body.Strong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:visibility="gone" />

        <!-- Message : visible uniquement une fois déplié -->
        <TextView
            android:id="@+id/incidentMessage"
            style="@style/Vigie.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:lineSpacingExtra="3dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/incidentPeriod"
            style="@style/Vigie.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
