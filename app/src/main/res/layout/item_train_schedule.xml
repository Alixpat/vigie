<?xml version="1.0" encoding="utf-8"?>
<!-- Un départ : une ligne de la carte de sens, pas une carte dans la carte. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Filet de séparation, masqué sur la première ligne -->
    <View
        android:id="@+id/scheduleDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/space_l"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/space_l"
        android:paddingEnd="@dimen/space_xs"
        android:paddingTop="@dimen/space_m"
        android:paddingBottom="@dimen/space_m"
        android:background="?attr/selectableItemBackground">

        <!-- Heure de départ (barrée si retard ou suppression) + heure réelle -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="60dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/scheduleAimedTime"
                style="@style/Vigie.Text.Time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/scheduleExpectedTime"
                style="@style/Vigie.Text.Body.Strong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Terminus, arrivée chez moi, train -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_m"
            android:orientation="vertical">

            <TextView
                android:id="@+id/scheduleDestination"
                style="@style/Vigie.Text.Body.Strong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/scheduleDetails"
                style="@style/Vigie.Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFeatureSettings="tnum"
                android:visibility="gone" />

            <TextView
                android:id="@+id/scheduleTrainInfo"
                style="@style/Vigie.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/scheduleStatus"
            style="@style/Vigie.Text.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s" />

        <ImageView
            android:id="@+id/schedulePin"
            style="@style/Vigie.IconButton"
            android:src="@drawable/ic_pin"
            android:contentDescription="Suivre ce train" />
    </LinearLayout>

</LinearLayout>
