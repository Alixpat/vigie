<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_card">

    <!-- En-tête : pictogramme, titre, compte des trains, bascule, fermer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/space_l"
        android:paddingEnd="@dimen/space_xs"
        android:paddingTop="@dimen/space_s"
        android:paddingBottom="@dimen/space_s">

        <TextView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_line_badge"
            android:gravity="center"
            android:text="N"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/on_line_n"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_m"
            android:orientation="vertical">

            <TextView
                style="@style/Vigie.Text.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Plan de la ligne" />

            <TextView
                android:id="@+id/lineMapTrainCount"
                style="@style/Vigie.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Bascule « tout le trafic » / « seulement les trains qui desservent
             mes deux gares » : sur un téléphone, une cinquantaine de triangles
             finit par cacher les deux ou trois qui comptent. -->
        <TextView
            android:id="@+id/lineMapFilter"
            style="@style/Vigie.Text.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/space_m"
            android:paddingEnd="@dimen/space_m"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/lineMapClose"
            style="@style/Vigie.IconButton"
            android:layout_marginStart="@dimen/space_xs"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary"
            android:contentDescription="Fermer" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- ScrollView contenant la vue schématique -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.alixpat.vigie.view.LineMapView
                android:id="@+id/lineMapView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="400dp" />

        </HorizontalScrollView>
    </ScrollView>

</LinearLayout>
